<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fm_deploy_barometer</name>
  <version>0.1.0</version>
  <description>fm_deploy (FM-Planner on the real drone) with the altitude measured by the barometer instead of the GPS-referenced EKF z, plus a return-along-the-flown-path recovery for recoverable planner stops. The planner, the model and fm_deploy's own code are used unchanged.</description>
  <maintainer email="michaelbryanjahanto@gmail.com">michael</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>octomap_msgs</exec_depend>
  <exec_depend>mavros</exec_depend>

  <depend>fm_deploy</depend>
  <depend>takeoff_land_barometer</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>python3-numpy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
