<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fm_deploy</name>
  <version>1.0.0</version>
  <description>FM-Planner inference on real hardware (Jetson Orin Nano + PX4/MAVROS + Orbbec Gemini 2). Perencana identik dengan versi simulasi; tambahan hanya lapisan keselamatan hardware.</description>
  <maintainer email="michaelbryanjahanto@gmail.com">michael</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>octomap_msgs</exec_depend>
  <exec_depend>mavros</exec_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>python3-scipy</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
