# ── colcon build output (not source) ─────────────────────────────────────
# Note: build/takeoff_land and install/takeoff_land were already tracked
# before this file existed. They are deliberately NOT removed from the index,
# so that a partner's `git pull` does not delete their working directories.
build/
install/
log/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Backups made before editing (this workspace's convention) ────────────
# Pattern: <name>.bak-<label>-<time>. The history is already in git.
*.bak-*
*.bak

# ── Models (large; an .engine only runs on this Jetson's TensorRT + GPU) ─
# fm_planner_*.engine 72 MB, *_trt.onnx 44 MB, model/fm/neo/ 123 MB.
# If they need versioning, use Git LFS, not plain git.
src/fm_deploy/model/
*.engine
*.pth

# ── Flight logs & archives ───────────────────────────────────────────────
*.ulg
*.zip

# ── Editor / OS ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
